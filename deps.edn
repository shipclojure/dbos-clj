{:paths ["src" "resources"]
 :deps {dev.dbos/transact {:mvn/version "1.0.0"}
        ;; Logging facade & context bridging
        com.taoensso/trove {:mvn/version "1.2.0"}
        com.cognitect/transit-clj {:mvn/version "1.0.333"}}
 :aliases
 {:build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          com.kepler16/kaven {:mvn/version "1.0.0-alpha.1"}}
   :ns-default build
   :extra-paths ["build"]}
  :dev
  {:extra-deps {com.taoensso/telemere {:mvn/version "1.2.0"}
                com.taoensso/telemere-slf4j {:mvn/version "1.2.0"}}
   :extra-paths ["dev" "test" "example/resources" "example/src"]}

  ;; No :main-opts — launchpad puts this on the REPL classpath and they'd
  ;; hijack its nREPL bootstrap.
  :test
  {:extra-deps
   {lambdaisland/kaocha {:mvn/version "1.91.1392"}
    integrant/integrant {:mvn/version "1.0.1"}
    com.taoensso/telemere {:mvn/version "1.2.0"}
    com.taoensso/telemere-slf4j {:mvn/version "1.2.0"}}
   :extra-paths ["test" "example/src" "example/resources"]}

  ;; Kaocha entrypoint. Always paired with :test alias
  :test-runner
  {:main-opts ["-m" "kaocha.runner"]}}}
