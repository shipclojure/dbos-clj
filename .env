# Local dev environment. Committed on purpose — throwaway credentials for a
# container on your laptop, not secrets.
#
# Read natively by bin/launchpad (into the REPL env), docker compose, and
# bin/kaocha. Overrides, lowest first:
#   .env  <  .env.local  <  deps.local.edn {:launchpad/options {:dev/env {…}}}

# Not 5432: that port is usually already taken by another project.
DBOS_PG_HOST=localhost
DBOS_PG_PORT=54329

# Dev account from docker/init-db.dev.sql.
DBOS_DB_USER=dbos
DBOS_DB_PASSWORD=dbos
DBOS_DEV_DB=dbos_clj_dev
DBOS_TEST_DB=dbos_clj_test

# URLs are literal rather than interpolated — compose and dotenv disagree on
# interpolation rules, a plain string means the same to both.

# Read by dbos.core-integration-test and dbos.example.system.
DBOS_TEST_DATABASE_URL=jdbc:postgresql://localhost:54329/dbos_clj_test
DBOS_TEST_DB_USER=dbos
DBOS_TEST_DB_PASSWORD=dbos

# Scratch database for the REPL.
DBOS_DATABASE_URL=jdbc:postgresql://localhost:54329/dbos_clj_dev
