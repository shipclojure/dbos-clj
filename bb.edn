{:paths ["scripts"]
 :deps {com.lambdaisland/launchpad {:mvn/version "0.45.201-alpha"}}

 :tasks {dev {:doc "Start the dev environment: Postgres + nREPL on 7899. See bin/launchpad."
              :task (shell "bin/launchpad")}

         db:up {:doc "Start the dev Postgres in the background."
                :task (shell "docker compose up -d")}

         db:down {:doc "Stop the dev Postgres, keeping its data."
                  :task (shell "docker compose down")}

         db:reset {:doc "Wipe the dev Postgres and recreate it from docker/init-db.dev.sql."
                   :task (do (shell "docker compose down -v")
                             (shell "docker compose up -d"))}

         db:psql {:doc "Open a psql shell on the dev database."
                  :task (shell "docker compose exec postgres psql -U dbos -d dbos_clj_dev")}

         lint {:doc "Linting project's code"
               :task (shell "clj-kondo" "--parallel" "--lint" "src" "test")}

         test {:doc "Run the tests. Needs the dev Postgres (`bb dev` or `bb db:up`). Extra args go to kaocha."
               :task (apply shell "bin/kaocha" *command-line-args*)}

         build {:doc "Build the library jar into target/ (version from the latest v* git tag)."
                :task (shell "clojure -T:build build")}

         tag {:doc "Prepare and publish a release: promote the changelog's Unreleased section, bump the README, then commit, tag and push. Usage: bb tag 0.3.0"
              :requires ([make])
              :task (apply make/tag *command-line-args*)}

         changelog-entry {:doc "Print one release's changelog section, for GitHub release notes. Defaults to the latest tag."
                          :requires ([make])
                          :task (apply make/changelog-entry *command-line-args*)}

         release {:doc "Build and deploy the library to Clojars. Reads the deploy token from 1Password, so `op` must be installed and signed in."
                  :requires ([make])
                  :task (shell {:extra-env
                                {"CLOJARS_USERNAME" "ovistoica"
                                 "CLOJARS_PASSWORD" (make/op-read "op://Personal/Clojars Token/credential")}}
                               "clojure -T:build release")}
         format:check {:doc "Check code formatting with cljfmt"
                       :task (shell "cljfmt" "check" "src" "test" "portfolio" "env" "dev" "resources")}
         format:project {:doc "Run cljfmt formatting on the entire codebase"
                         :task (shell "cljfmt" "fix" "src" "test" "portfolio" "env" "dev" "resources")}}}
